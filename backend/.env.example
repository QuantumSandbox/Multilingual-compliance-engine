GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ===== Embeddings =====
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ===== Security =====
SECRET_KEY=dev-secret-change-me
